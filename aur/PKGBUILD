pkgname=boci-bin
pkgver=0.0.2
pkgrel=1
pkgdesc="Fast Bun drop-in replacement for the OCI CLI"
arch=('x86_64' 'aarch64')
url="https://github.com/neves/boci"
license=('MIT')
provides=('boci')
conflicts=('boci')
source_x86_64=("boci-linux-x64-${pkgver}::${url}/releases/download/v${pkgver}/boci-linux-x64")
source_aarch64=("boci-linux-arm64-${pkgver}::${url}/releases/download/v${pkgver}/boci-linux-arm64")
sha256sums_x86_64=('dd42fad0dc04b8a5bf7896a2dddc2b8820d89f82be469dfd5df8f606e9b8f846')
sha256sums_aarch64=('c806607753e016eb25c1f64d8f7ce938d4f9e97e74d9fcc2d4e7b912bdfb492e')

package() {
  local bin="boci-linux-x64-${pkgver}"
  if [ "$CARCH" = "aarch64" ]; then
    bin="boci-linux-arm64-${pkgver}"
  fi
  install -Dm755 "${srcdir}/${bin}" "${pkgdir}/usr/bin/boci"
}
