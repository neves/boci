{
  "name": "boci",
  "version": "0.0.0",
  "description": "A fast Bun drop-in replacement for the OCI CLI",
  "type": "module",
  "private": true,
  "bin": {
    "boci": "src/main.ts"
  },
  "scripts": {
    "status": "bun scripts/status.ts",
    "extract": "uv run --python 3.12 tools/extract/extract.py && bun fmt spec",
    "build": "bun build --compile --minify src/main.ts --outfile dist/boci",
    "record": "bun --env-file=.env.test scripts/record.ts",
    "golden": "bun scripts/golden.ts",
    "bench": "bun bench/bench.ts",
    "bench:live": "bun --env-file=.env.test bench/bench.ts --live",
    "parity:live": "BOCI_LIVE=1 bun --env-file=.env.test test test/live"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
