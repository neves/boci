{
  "name": "boci-cli",
  "version": "0.0.1",
  "description": "A fast Bun drop-in replacement for the OCI CLI",
  "license": "MIT",
  "homepage": "https://github.com/neves/boci#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neves/boci.git"
  },
  "bugs": {
    "url": "https://github.com/neves/boci/issues"
  },
  "keywords": [
    "oci",
    "oracle",
    "oracle-cloud",
    "cli",
    "bun"
  ],
  "type": "module",
  "files": [
    "src",
    "spec",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "boci": "src/main.ts"
  },
  "scripts": {
    "status": "bun scripts/status.ts",
    "ladder": "bun scripts/ladder.ts",
    "triage": "bun scripts/triage.ts",
    "scaffold": "bun scripts/scaffold.ts",
    "verify": "bun scripts/verify.ts",
    "spec": "bun scripts/spec.ts",
    "extract": "uv run --python 3.12 tools/extract/extract.py && bun fmt spec",
    "build": "bun scripts/build.ts",
    "record": "bun --env-file=.env.test scripts/record.ts",
    "golden": "bun scripts/golden.ts",
    "fuzz": "bun scripts/fuzz.ts",
    "parity:cases": "bun scripts/generate-cases.ts",
    "bench": "bun bench/bench.ts",
    "bench:live": "bun --env-file=.env.test bench/bench.ts --live",
    "test:dist": "bun run build && BOCI_BIN=dist/boci BOCI_PARITY_ALL=1 BOCI_PARITY_SPAWN=all bun test test/parity",
    "parity:live": "BOCI_LIVE=1 bun --env-file=.env.test test test/live"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "jmespath": "^0.16.0"
  }
}
