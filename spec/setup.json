    "bootstrap": {
      "hidden": false,
      "helpDoc": {
        "usage": "[OPTIONS]",
        "text": "Provides an interactive process to create a CLI config file using username / password based login through a browser.\nAlso handles generating API keys and uploading them to your Oracle Cloud Infrastructure account.\n\nNote that port 8181 must be available in order for this command to complete properly.",
        "records": [
          ["--profile-name TEXT", "Name of the profile you are creating"],
          ["--config-location TEXT", "Path to the config for the new profile"],
          [
            "-?, -h, --help",
            "For detailed help on any of these individual commands, enter <command> --help."
