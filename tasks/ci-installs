#!/usr/bin/env bash
#MISE description="Test all install methods across Linux, macOS, and Windows on GitHub Actions"
set -euo pipefail

OUT=$(gh workflow run test-installs.yml)
echo "$OUT"
RUN_ID=$(echo "$OUT" | grep -oE '[0-9]+$' || true)
if [ -z "$RUN_ID" ]; then
  sleep 3
  RUN_ID=$(gh run list --workflow=test-installs.yml -L 1 --json databaseId -q '.[0].databaseId')
fi
gh run watch "$RUN_ID" --exit-status
gh run view "$RUN_ID" --log
