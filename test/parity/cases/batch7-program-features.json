[
  {
    "id": "batch7-dbtools-execute-sql-async",
    "key": "dbtools-runtime connection execute-sql async",
    "argv": [
      "dbtools-runtime",
      "connection",
      "execute-sql",
      "async",
      "--connection-id",
      "ocid1.dbtoolsconnection.oc1..c1",
      "--request-input",
      "{\"sqlStatement\":\"SELECT 1 FROM DUAL\",\"responseFormat\":{\"result\":false}}",
      "--request-output",
      "{\"type\":\"OBJECT_STORAGE\",\"namespaceName\":\"ns1\",\"bucketName\":\"b1\",\"objectName\":\"o1\"}",
      "--output-time-of-deletion",
      "2030-01-01T00:00:00Z",
      "--timeout-in-seconds",
      "60",
      "--if-match",
      "etag-1",
      "--endpoint",
      "{endpoint}",
      "--no-retry"
    ],
    "requestOnly": true,
    "replies": {
      "body": { "status": "ACCEPTED" },
      "headers": { "opc-work-request-id": "ocid1.workrequest.oc1..w1" }
    }
  },
  {
    "id": "batch7-dbtools-execute-sql-sync",
    "key": "dbtools-runtime connection execute-sql sync",
    "argv": [
      "dbtools-runtime",
      "connection",
      "execute-sql",
      "sync",
      "--connection-id",
      "ocid1.dbtoolsconnection.oc1..c1",
      "--request-input",
      "{\"sqlStatement\":\"SELECT 1 FROM DUAL\",\"responseFormat\":{}}",
      "--if-match",
      "etag-2",
      "--endpoint",
      "{endpoint}",
      "--no-retry"
    ],
    "requestOnly": true,
    "replies": {
      "body": { "items": [{ "result": "ok" }] }
    }
  },
