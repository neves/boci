      "--multipart-threads",
      "2",
      "--endpoint",
      "{endpoint}",
      "--no-retry"
    ],
    "replies": {
      "body": {
        "id": "ocid1.datasynctask.oc1..t1",
        "taskDefinitionId": "ocid1.datasyncdef.oc1..td1",
        "lifecycleState": "RUNNING"
      }
    }
