[
  {
    "id": "compute-instance-action-stop",
    "key": "compute instance action",
    "argv": [
      "compute",
      "instance",
      "action",
      "--instance-id",
      "ocid1.instance.oc1..test",
      "--action",
      "STOP",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": [
      {
        "body": {
          "lifecycleState": "STOPPING"
        }
      }
    ]
  },
  {
    "id": "compute-instance-action-scheduled",
    "key": "compute instance action",
    "argv": [
      "compute",
      "instance",
      "action",
      "--instance-id",
      "ocid1.instance.oc1..test",
      "--action",
      "STOP",
      "--if-match",
      "etag-test",
      "--allow-dense-reboot-migration",
      "--delete-local-storage",
      "--time-scheduled",
      "2026-12-01T12:00:00+00:00",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": [
      {
        "body": {
          "id": "ocid1.instance.oc1..test",
          "lifecycleState": "STOPPING"
        }
      }
    ]
  },
  {
    "id": "compute-instance-action-waits-for-state",
    "key": "compute instance action",
    "argv": [
      "compute",
      "instance",
      "action",
      "--instance-id",
      "ocid1.instance.oc1..test",
      "--action",
      "STOP",
      "--wait-for-state",
      "STOPPED",
      "--wait-interval-seconds",
      "0",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": [
      {
        "body": {
          "id": "ocid1.instance.oc1..test",
          "lifecycleState": "STOPPING"
        }
      },
      {
        "body": {
          "id": "ocid1.instance.oc1..test",
          "lifecycleState": "STOPPED"
        }
      }
    ]
  }
]
