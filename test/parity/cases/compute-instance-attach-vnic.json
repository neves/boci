[
  {
    "id": "compute-instance-attach-vnic",
    "key": "compute instance attach-vnic",
    "argv": [
      "compute",
      "instance",
      "attach-vnic",
      "--instance-id",
      "ocid1.instance.oc1..test",
      "--subnet-id",
      "ocid1.subnet.oc1..test",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": [
      {
        "body": {
          "id": "ocid1.vnic.oc1..test",
          "lifecycleState": "ATTACHED",
          "privateIp": "10.0.0.2"
        }
      }
    ]
  }
]
