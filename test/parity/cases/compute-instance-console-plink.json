[
  {
    "id": "compute-instance-console-plink-defaults",
    "key": "compute instance-console-connection get-plink-connection-string",
    "argv": [
      "compute",
      "instance-console-connection",
      "get-plink-connection-string",
      "--instance-console-connection-id",
      "ocid1.instanceconsoleconnection.oc1..test",
      "--private-key-file",
      "/tmp/private-key.pem",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": [
      {
        "body": {
          "id": "ocid1.instanceconsoleconnection.oc1..test",
          "connectionString": "ssh -i key.pem instance-console.us-ashburn-1.oraclecloud.com",
          "instanceId": "ocid1.instance.oc1..test",
          "lifecycleState": "ACTIVE"
        }
      }
    ]
  },
  {
    "id": "compute-instance-console-plink-custom-ports",
    "key": "compute instance-console-connection get-plink-connection-string",
    "argv": [
      "compute",
      "instance-console-connection",
      "get-plink-connection-string",
      "--instance-console-connection-id",
      "ocid1.instanceconsoleconnection.oc1..test",
      "--private-key-file",
      "C:/Users/test/key.ppk",
      "--local-vnc-port",
      "5901",
      "--ssh-proxy-port",
      "5906",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": [
      {
        "body": {
          "id": "ocid1.instanceconsoleconnection.oc1..test",
          "connectionString": "ssh instance-console.us-ashburn-1.oraclecloud.com",
          "instanceId": "ocid1.instance.oc1..test",
          "lifecycleState": "ACTIVE"
        }
      }
    ]
  },
  {
    "id": "compute-instance-console-plink-rejects-blank-id",
    "key": "compute instance-console-connection get-plink-connection-string",
    "argv": [
      "compute",
      "instance-console-connection",
      "get-plink-connection-string",
      "--instance-console-connection-id",
      "   ",
      "--private-key-file",
      "/tmp/private-key.pem"
    ]
  }
]
