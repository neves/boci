[
  {
    "id": "version",
    "key": "--version",
    "argv": ["--version"]
  },
  {
    "id": "version-short",
    "key": "--version",
    "argv": ["-v"]
  },
  {
    "id": "version-before-help",
    "key": "--version",
    "argv": ["--version", "--help"]
  },
  {
    "id": "os-ns-get-jmespath-query",
    "key": "--query",
    "argv": ["os", "ns", "get", "--endpoint", "{endpoint}", "--query", "data"],
    "replies": { "body": "\"fake-namespace\"" }
  },
  {
    "id": "os-ns-get",
    "key": "os ns get",
    "argv": ["os", "ns", "get", "--endpoint", "{endpoint}"],
    "replies": {
      "body": "\"fake-namespace\""
    }
  },
  {
    "id": "os-ns-get-response-etag",
    "key": "os ns get",
    "argv": ["os", "ns", "get", "--endpoint", "{endpoint}"],
    "replies": {
      "headers": { "etag": "fake-etag", "opc-request-id": "fake-request-id" },
      "body": "\"fake-namespace\""
    }
  },
  {
    "id": "os-ns-get-profile-missing",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--endpoint",
      "{endpoint}",
      "--profile",
      "missing-profile"
    ]
  },
  {
    "id": "os-ns-get-config-missing",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--endpoint",
      "{endpoint}",
      "--config-file",
      "~/.oci/missing-config"
    ]
  },
  {
    "id": "os-ns-get-invalid-key",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--endpoint",
      "{endpoint}",
      "--profile",
      "bad-key"
    ],
    "config": "[bad-key]\nkey_file = ~/.oci/bad.pem\n",
    "sandbox": { "files": { ".oci/bad.pem": "not a private key\n" } }
  },
  {
    "id": "os-ns-get-config-permissions",
    "key": "os ns get",
    "argv": ["os", "ns", "get", "--endpoint", "{endpoint}"],
    "sandbox": { "configMode": 420 }
  },
  {
    "id": "os-ns-get-key-permissions",
    "key": "os ns get",
    "argv": ["os", "ns", "get", "--endpoint", "{endpoint}"],
    "sandbox": { "keyMode": 420 }
  },
  {
    "id": "os-ns-get-service-error",
    "key": "os ns get",
    "argv": ["os", "ns", "get", "--endpoint", "{endpoint}"],
    "replies": {
      "status": 404,
      "headers": { "opc-request-id": "fake-request-id" },
      "body": {
        "code": "NotAuthorizedOrNotFound",
        "message": "resource not found",
        "status": 404,
        "target_service": "object_storage"
      }
    }
  },
  {
    "id": "os-ns-get-request-id",
    "key": "os ns get",
    "argv": [
      "--request-id",
      "boci-request-123",
      "os",
      "ns",
      "get",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": { "body": "\"fake-namespace\"" }
  },
  {
    "id": "os-ns-get-debug",
    "key": "debug",
    "argv": ["--debug", "os", "ns", "get", "--endpoint", "{endpoint}"],
    "replies": { "body": "\"fake-namespace\"" }
  },
  {
    "id": "os-ns-get-connection-timeout",
    "key": "os ns get",
    "argv": [
      "--connection-timeout",
      "10",
      "os",
      "ns",
      "get",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": { "body": "\"fake-namespace\"" }
  },
  {
    "id": "os-ns-get-read-timeout",
    "key": "read-timeout",
    "argv": [
      "--read-timeout",
      "1",
      "--no-retry",
      "os",
      "ns",
      "get",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": { "delayMs": 1500, "body": "\"fake-namespace\"" }
  },
  {
    "id": "os-ns-get-no-retry",
    "key": "no-retry",
    "argv": ["--no-retry", "os", "ns", "get", "--endpoint", "{endpoint}"],
    "replies": { "body": "\"fake-namespace\"" }
  },
  {
    "id": "os-ns-get-max-retries",
    "key": "max-retries",
    "argv": [
      "--max-retries",
      "2",
      "os",
      "ns",
      "get",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": [
      {
        "status": 429,
        "body": { "code": "TooManyRequests", "message": "retry once" }
      },
      { "body": "\"fake-namespace\"" }
    ]
  },
