  {
    "id": "os-ns-get-request-id",
    "key": "os ns get",
    "argv": [
      "--request-id",
      "boci-request-123",
      "os",
      "ns",
      "get",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": {
      "body": "\"fake-namespace\""
    },
    "expect": {
      "requestHeaders": { "opc-client-request-id": "boci-request-123" }
    }
  },
  {
    "id": "os-ns-get-debug",
    "key": "debug",
    "argv": ["--debug", "os", "ns", "get", "--endpoint", "{endpoint}"],
    "replies": {
      "body": "\"fake-namespace\""
    },
    "expect": {
      "golden": false,
      "exitCode": 0,
      "stdoutContains": "\"data\": \"fake-namespace\"",
      "stderrMatches": [
        "DEBUG:.*Request: GET .*\\/n",
        "DEBUG:.*Response status: 200"
      ]
    }
  },
  {
    "id": "os-ns-get-connection-timeout",
