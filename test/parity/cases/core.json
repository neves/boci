  {
    "id": "os-ns-get-connection-timeout-slow-headers",
    "key": "os ns get",
    "argv": [
      "--connection-timeout",
      "1",
      "--no-retry",
      "os",
      "ns",
      "get",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": { "delayMs": 1300, "body": "\"fake-namespace\"" }
