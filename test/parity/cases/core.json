[
  {
    "id": "version",
    "key": "--version",
    "argv": ["--version"]
  },
  {
    "id": "version-short",
    "key": "--version",
    "argv": ["-v"]
  },
  {
    "id": "version-before-help",
    "key": "--version",
    "argv": ["--version", "--help"]
  },
  {
    "id": "os-ns-get",
    "key": "os ns get",
    "argv": ["os", "ns", "get", "--endpoint", "{endpoint}"],
    "replies": {
      "body": "\"fake-namespace\""
    }
  },
  {
    "id": "os-ns-get-profile-missing",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--endpoint",
      "{endpoint}",
      "--profile",
      "missing-profile"
    ]
  },
  {
    "id": "os-ns-get-config-missing",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--endpoint",
      "{endpoint}",
      "--config-file",
      "~/.oci/missing-config"
    ]
  },
  {
    "id": "usage-unknown-option",
    "key": "usage:unknown-option",
    "argv": ["os", "ns", "get", "--no-such-flag"]
  },
  {
    "id": "usage-unknown-command",
    "key": "usage:unknown-command",
    "argv": ["no-such-service"]
  }
]
