      "ns",
      "get",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": {
      "delayMs": 1500,
      "body": "\"fake-namespace\""
    },
    "expect": {
      "golden": false,
      "exitCode": 1,
      "stdout": "",
      "stderrContains": "TimeoutError",
      "requests": 1
