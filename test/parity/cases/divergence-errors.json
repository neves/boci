      "9999999999999"
    ],
    "expect": {
      "golden": false,
      "exitCode": 1,
      "stdout": "",
      "stderrContains": "ValueError: year 318857 is out of range",
      "requests": 0
    }
  },
  {
    "id": "divergence-date-libc",
    "key": "convert",
    "argv": [
      "database-management",
      "diagnosability",
      "managed-database",
      "list-alert-logs",
