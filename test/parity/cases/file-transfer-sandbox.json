[
  {
    "id": "file-transfer-sandbox-literal",
    "key": "generative-ai-sandbox sandbox-file write",
    "argv": [
      "generative-ai-sandbox",
      "sandbox-file",
      "write",
      "--sandbox-id",
      "sandbox",
      "--sandbox-file-path",
      "folder/data",
      "--file",
      "é\n",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": {
      "body": {
        "contentSha256": "checksum",
        "filePath": "folder/data",
        "sandboxId": "sandbox"
      }
    }
  },
