[
  {
    "id": "dbm-oracle-connection-files",
    "key": "database-migration connection create-oracle-connection",
    "argv": [
      "database-migration",
      "connection",
      "create-oracle-connection",
      "--display-name",
      "d1",
      "-c",
      "ocid1.compartment.oc1..c",
      "--vault-id",
      "ocid1.vault.oc1..v",
      "--key-id",
      "ocid1.key.oc1..k",
      "--username",
      "u",
      "--password",
      "p",
      "--technology-type",
      "ORACLE_DATABASE",
      "--sshkey-file",
      "key.txt",
      "--wallet",
      "cwallet.sso",
      "--ssh-host",
      "h",
      "--ssh-user",
      "opc",
      "--endpoint",
      "{endpoint}"
    ],
    "sandbox": {
      "files": {
        "key.txt": "-----BEGIN KEY-----\r\nK\r\n-----END KEY-----\r\n",
        "cwallet.sso": "WALLET\u0001ÿ bytes\n",
        "walletdir/x": "x",
        "locked.sso": "secret"
      }
    },
    "requestOnly": true,
    "replies": {
      "body": {
        "connectionType": "ORACLE",
        "id": "ocid1.conn.oc1..x"
      }
    }
  },
