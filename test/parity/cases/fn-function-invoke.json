[
  {
    "id": "fn-function-invoke",
    "key": "fn function invoke",
    "argv": [
      "--endpoint",
      "{endpoint}",
      "--no-retry",
      "--opc-request-id",
      "test-request",
      "fn",
      "function",
      "invoke",
      "--function-id",
      "test-function",
      "--file",
      "-",
      "--body",
      "hello"
    ],
    "replies": [
      {
        "status": 200,
        "body": {
          "invokeEndpoint": "{endpoint}/invoke-base"
        }
      },
      {
        "status": 200,
        "body": "invoked"
      }
    ],
    "expect": {
      "fileModes": {
        ".oci/functions-invoke-endpoint-cache.json": 384
      }
    }
  },
  {
    "id": "fn-function-invoke-uncached",
