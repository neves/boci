  {
    "id": "fn-function-invoke-file",
    "key": "fn function invoke",
    "argv": [
      "--endpoint",
      "{endpoint}",
      "--no-retry",
      "--opc-request-id",
      "test-request",
      "fn",
      "function",
      "invoke",
      "--function-id",
      "test-function",
      "--file",
      "-",
      "--body",
      "hello",
      "--file",
      "result.txt",
