      "test-request",
      "fn",
      "function",
      "invoke",
      "--function-id",
      "test-function",
      "--file",
      "-",
      "--body",
      "hello",
      "--no-endpoint-cache",
      "--is-dry-run",
      "true",
      "--fn-intent",
      "cloudevent"
    ],
    "replies": [
      {
        "status": 200,
        "body": {
          "invokeEndpoint": "{endpoint}/invoke-base"
        }
      },
      {
        "status": 200,
        "body": "invoked"
