[
  {
    "id": "generative-ai-sandbox-sandbox-file-read-stdout",
    "key": "generative-ai-sandbox sandbox-file read",
    "argv": [
      "generative-ai-sandbox",
      "sandbox-file",
      "read",
      "--sandbox-id",
      "ocid1.sandbox.oc1..aaa",
      "--sandbox-file-path",
      "/tmp/hello.txt",
      "--file",
      "-",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": [
      {
        "headers": {
          "content-type": "application/octet-stream"
        },
        "body": "hello sandbox\n"
      }
    ]
  },
  {
    "id": "generative-ai-sandbox-sandbox-file-read-local-file",
    "key": "generative-ai-sandbox sandbox-file read",
    "argv": [
      "generative-ai-sandbox",
      "sandbox-file",
      "read",
      "--sandbox-id",
      "ocid1.sandbox.oc1..aaa",
      "--sandbox-file-path",
      "/tmp/hello.txt",
      "--local-file",
      "out.txt",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": [
      {
        "headers": {
          "content-type": "application/octet-stream"
        },
        "body": "saved bytes"
      }
    ],
    "expect": {
      "files": {
        "out.txt": "saved bytes"
      }
    }
  },
  {
    "id": "generative-ai-sandbox-sandbox-file-read-empty",
    "key": "generative-ai-sandbox sandbox-file read",
    "argv": [
      "generative-ai-sandbox",
      "sandbox-file",
      "read",
      "--sandbox-id",
      "ocid1.sandbox.oc1..aaa",
      "--sandbox-file-path",
      "/tmp/empty.txt",
      "--file",
      "empty.txt",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": [
      {
        "headers": {
          "content-type": "application/octet-stream"
        },
        "body": ""
      }
    ],
    "expect": {
      "files": {
        "empty.txt": ""
      }
    }
  },
  {
    "id": "generative-ai-sandbox-sandbox-file-read-both-files-error",
    "key": "generative-ai-sandbox sandbox-file read",
    "argv": [
      "generative-ai-sandbox",
      "sandbox-file",
