[
  { "id": "rhelp-help", "key": "help:root", "argv": ["--help"] },
  { "id": "rhelp-h", "key": "help:root", "argv": ["-h"] },
  { "id": "rhelp-q", "key": "help:root", "argv": ["-?"] },
  { "id": "rhelp-noargs", "key": "help:root", "argv": [] },
  {
    "id": "rhelp-columns-60",
    "key": "help:root",
    "argv": ["--help"],
    "env": { "COLUMNS": "60" }
  },
  {
    "id": "rhelp-columns-120",
    "key": "help:root",
    "argv": ["--help"],
    "env": { "COLUMNS": "120" }
  }
]
