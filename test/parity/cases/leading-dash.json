[
  {
    "id": "leading-dash-cluster-interactive",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--compartment-id",
      "-leading-dash",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": {
      "body": "\"fake-namespace\""
    }
  },
  {
    "id": "leading-dash-unknown-short-passthrough",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--compartment-id",
      "-foo",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": {
      "body": "\"fake-namespace\""
    }
  },
  {
    "id": "leading-dash-leaf-short-opt-as-value",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--compartment-id",
      "-c",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": {
      "body": "\"fake-namespace\""
    }
  },
  {
    "id": "leading-dash-double-dash-value",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--compartment-id",
      "--foo",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": {
      "body": "\"fake-namespace\""
    }
  },
  {
    "id": "leading-dash-equals-attached",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--compartment-id=-leading-dash",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": {
      "body": "\"fake-namespace\""
    }
  },
  {
    "id": "leading-dash-short-v-cluster",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--compartment-id",
      "-abc-v",
      "--endpoint",
      "{endpoint}"
    ]
  },
  {
    "id": "leading-dash-short-h-alone",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--compartment-id",
      "-h",
      "--endpoint",
      "{endpoint}"
    ]
  },
  {
    "id": "leading-dash-short-h-cluster",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--compartment-id",
      "-abc-h",
      "--endpoint",
      "{endpoint}"
    ]
  },
  {
    "id": "leading-dash-short-i-alone",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--compartment-id",
      "-i",
      "--endpoint",
      "{endpoint}"
    ]
  },
  {
    "id": "leading-dash-short-i-cluster",
    "key": "os ns get",
    "argv": [
      "os",
      "ns",
      "get",
      "--compartment-id",
      "-x-i",
      "--endpoint",
      "{endpoint}"
    ]
  },
  {
    "id": "leading-dash-bare-i",
    "key": "usage",
    "argv": ["-i"]
  },
  {
    "id": "leading-dash-cli-auto-prompt-flag",
    "key": "usage",
    "argv": ["--cli-auto-prompt"]
  },
  {
    "id": "leading-dash-unknown-cmd-with-i",
    "key": "usage",
    "argv": ["nosuchcmd", "-i"]
  },
  {
    "id": "leading-dash-existing-suggestion-file",
    "key": "os ns get",
    "argv": ["os", "ns", "get", "-i"],
    "sandbox": {
      "files": {
        "suggestion_variable.txt": "1"
      }
    }
  },
  {
    "id": "leading-dash-missing-config-eof",
    "key": "os ns get",
    "argv": ["os", "ns", "get", "-i", "--config-file", "~/.oci/missing"]
  },
  {
    "id": "leading-dash-missing-config-decline",
    "key": "os ns get",
    "argv": ["os", "ns", "get", "-i", "--config-file", "~/.oci/missing"],
    "stdin": "n\n"
  },
  {
    "id": "leading-dash-missing-profile",
    "key": "os ns get",
    "argv": ["os", "ns", "get", "-i", "--profile", "nope"]
  },
  {
    "id": "leading-dash-env-auto-prompt",
    "key": "os ns get",
    "argv": ["os", "ns", "get", "--endpoint", "{endpoint}"],
    "env": {
      "OCI_CLI_AUTO_PROMPT": "True"
    }
  },
  {
    "id": "leading-dash-max-retries-no-retry-before-i",
    "key": "os ns get",
    "argv": ["os", "ns", "get", "-i", "--max-retries", "1", "--no-retry"]
  },
  {
    "id": "leading-dash-before-leaf-validation",
    "key": "compute instance list",
    "argv": [
      "compute",
      "instance",
      "list",
      "--sort-by",
      "NOT_A_CHOICE",
      "--compartment-id",
      "-leading-dash",
      "--endpoint",
      "{endpoint}"
    ]
  }
]
