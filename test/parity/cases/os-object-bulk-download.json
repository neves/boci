[
  {
    "id": "os-object-bulk-download-basic",
    "key": "os object bulk-download",
    "argv": [
      "--endpoint",
      "{endpoint}",
      "--no-retry",
      "os",
      "object",
      "bulk-download",
      "-ns",
      "myns",
      "-bn",
      "mybucket",
      "--download-dir",
      "{home}/dl",
      "--overwrite"
    ],
    "replies": [
      {
        "status": 200,
        "body": {
          "objects": [
            {
              "name": "hello.txt",
              "size": 12,
              "timeModified": "2026-10-21T07:28:00.000Z"
            }
          ]
        }
      },
      {
        "status": 200,
        "headers": {
          "content-type": "text/plain",
          "etag": "etag-hello"
        },
        "body": "hello world\n"
      }
    ],
    "expect": {
      "files": {
        "dl/hello.txt": "hello world\n"
      }
    }
  },
