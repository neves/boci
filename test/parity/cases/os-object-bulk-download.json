  {
    "id": "os-object-bulk-download-pagination",
    "key": "os object bulk-download",
    "argv": [
      "--endpoint",
      "{endpoint}",
      "--no-retry",
      "os",
      "object",
      "bulk-download",
      "-ns",
      "myns",
      "-bn",
      "mybucket",
      "--download-dir",
      "{home}/dl",
      "--no-overwrite",
      "--parallel-operations-count",
      "1"
    ],
    "sandbox": {
      "files": {
        "dl/a.txt": "keep-a"
      }
    },
    "replies": [
      {
        "status": 200,
        "body": {
          "objects": [
            {
              "name": "a.txt",
              "size": 1,
              "timeModified": "2026-10-21T07:28:00.000Z"
            }
          ],
          "nextStartWith": "b.txt"
        }
      },
      {
        "status": 200,
        "body": {
          "objects": [
            {
              "name": "b.txt",
              "size": 1,
              "timeModified": "2026-10-21T07:28:01.000Z"
            }
          ]
        }
      },
      {
        "status": 200,
        "headers": {
          "content-type": "text/plain"
        },
        "body": "B"
      }
    ],
    "expect": {
      "files": {
        "dl/a.txt": "keep-a",
        "dl/b.txt": "B"
      }
    }
  },
