[
  {
    "id": "os-object-bulk-upload-basic",
    "key": "os object bulk-upload",
    "argv": [
      "--endpoint",
      "{endpoint}",
      "--no-retry",
      "os",
      "object",
      "bulk-upload",
      "-ns",
      "myns",
      "-bn",
      "mybucket",
      "--src-dir",
      "{home}/src",
      "--overwrite"
    ],
    "sandbox": {
      "files": {
        "src/hello.txt": "hello world\n"
      }
    },
    "replies": [
      {
        "status": 200,
        "body": {
          "name": "mybucket",
          "namespace": "myns"
        }
      },
      {
        "status": 200,
        "headers": {
          "etag": "etag-hello",
          "opc-content-md5": "b1kCrCNwJL3QwXbLkwY9xA==",
          "last-modified": "Wed, 21 Oct 2026 07:28:00 GMT",
          "opc-request-id": "req-put-1",
          "x-ignored-header": "ignored"
        },
        "body": ""
      }
    ]
  },
