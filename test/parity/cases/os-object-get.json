  {
    "id": "os-object-get-options",
    "key": "os object get",
    "argv": [
      "--endpoint",
      "{endpoint}",
      "--no-retry",
      "os",
      "object",
      "get",
      "-ns",
      "myns",
      "-bn",
      "mybucket",
      "--name",
      "hello.txt",
      "--file",
      "-",
      "--version-id",
      "v1",
      "--if-match",
      "etag-1",
      "--if-none-match",
      "etag-2",
      "--range",
      "bytes=0-4",
      "--no-multipart",
      "--http-response-content-disposition",
      "attachment; filename=\"a.txt\"",
      "--http-response-cache-control",
      "no-cache",
      "--http-response-content-type",
      "text/plain",
      "--http-response-content-language",
      "en-US",
      "--http-response-content-encoding",
      "identity",
      "--http-response-expires",
      "Wed, 21 Oct 2026 07:28:00 GMT"
    ],
    "replies": [
      {
        "status": 200,
        "headers": {
          "content-length": "12",
          "etag": "etag-1"
        },
        "body": ""
      },
      {
        "status": 206,
        "headers": {
          "content-type": "text/plain"
        },
        "body": "hello"
      }
    ]
  },
