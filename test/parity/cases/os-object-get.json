[
  {
    "id": "os-object-get-stdout",
    "key": "os object get",
    "argv": [
      "--endpoint",
      "{endpoint}",
      "--no-retry",
      "os",
      "object",
      "get",
      "-ns",
      "myns",
      "-bn",
      "mybucket",
      "--name",
      "hello.txt",
      "--file",
      "-"
    ],
    "replies": [
      {
        "status": 200,
        "headers": {
          "content-length": "12",
          "etag": "etag-hello"
        },
        "body": ""
      },
      {
        "status": 200,
        "headers": {
          "content-type": "text/plain",
          "etag": "etag-hello"
        },
        "body": "hello world\n"
      }
    ]
  },
