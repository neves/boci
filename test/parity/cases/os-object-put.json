[
  {
    "id": "os-object-put-basic",
    "key": "os object put",
    "argv": [
      "--endpoint",
      "{endpoint}",
      "--no-retry",
      "os",
      "object",
      "put",
      "-ns",
      "myns",
      "-bn",
      "mybucket",
      "--name",
      "hello.txt",
      "--file",
      "{home}/hello.txt",
      "--force"
    ],
    "sandbox": {
      "files": {
        "hello.txt": "hello world\n"
      }
    },
    "replies": [
      {
        "status": 200,
        "headers": {
          "etag": "etag-hello",
          "opc-content-md5": "b1kCrCNwJL3QwXbLkwY9xA==",
          "last-modified": "Wed, 21 Oct 2026 07:28:00 GMT",
          "opc-request-id": "req-put-1",
          "x-ignored-header": "should-not-display"
        },
        "body": ""
      }
    ]
  },
