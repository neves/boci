[
  {
    "id": "os-object-restore-status-available",
    "key": "os object restore-status",
    "argv": [
      "os",
      "object",
      "restore-status",
      "-ns",
      "myns",
      "-bn",
      "mybucket",
      "--name",
      "file.txt",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": [
      {
        "status": 200,
        "headers": {
          "etag": "e1"
        }
      }
    ]
  },
  {
    "id": "os-object-restore-status-archived",
    "key": "os object restore-status",
    "argv": [
      "os",
      "object",
      "restore-status",
      "-ns",
      "myns",
      "-bn",
      "mybucket",
      "--name",
      "file.txt",
      "--endpoint",
      "{endpoint}"
    ],
    "replies": [
      {
        "status": 200,
        "headers": {
          "archival-state": "Archived"
        }
      }
    ]
  },
  {
    "id": "os-object-restore-status-restoring",
