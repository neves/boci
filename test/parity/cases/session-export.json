    "argv": ["session", "export", "--output-file", "{home}/exported-ok"],
    "config": "security_token_file=.oci/session-token\n",
    "sandbox": {
      "files": {
        ".oci/session-token": "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJleHAiOjIwODQxMDAwMDB9.sig"
      }
    }
  },
  {
