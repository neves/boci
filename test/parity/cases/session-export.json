  {
    "id": "session-export-profile-and-config-file",
    "key": "session export",
    "argv": [
      "session",
      "export",
      "--config-file",
      "{home}/.oci/custom_config",
      "--profile",
      "SESSION",
      "--output-file",
      "{home}/exported-prof"
    ],
    "sandbox": {
      "noConfig": true,
      "files": {
        ".oci/custom_config": "[DEFAULT]\nregion=us-ashburn-1\n\n[SESSION]\nregion=us-phoenix-1\nkey_file=~/.oci/key.pem\nsecurity_token_file=~/.oci/session-token\n",
        ".oci/key.pem": "{fakeKey}",
        ".oci/session-token": "session-token-data"
      }
    }
  },
  {
    "id": "session-export-config-file-tilde",
