[
  {
    "id": "session-import-ok",
    "key": "session import",
    "argv": ["session", "import", "--session-archive", "{home}/session.zip"],
    "sandbox": {
      "zipFiles": {
        "session.zip": {
          "config": "[SESSION]\nregion = us-phoenix-1\ntenancy = ocid1.tenancy.oc1..test\nkey_file = oci_api_key.pem\nsecurity_token_file = token\n",
          "oci_api_key.pem": "KEY-CONTENT-OK\n",
          "token": "TOKEN-CONTENT-OK"
        }
      }
    },
    "expect": {
      "files": {
        ".oci/sessions/SESSION/oci_api_key.pem": "KEY-CONTENT-OK\n",
        ".oci/sessions/SESSION/token": "TOKEN-CONTENT-OK"
      },
      "fileModes": {
        ".oci/config": 384,
        ".oci/sessions/SESSION/oci_api_key.pem": 384,
        ".oci/sessions/SESSION/token": 384
      }
    }
  },
  {
