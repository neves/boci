[
  {
    "id": "session-refresh-ok",
    "key": "session refresh",
    "argv": ["session", "refresh"],
    "config": "security_token_file=.oci/session-token\n",
    "httpsProxy": true,
    "sandbox": {
      "files": {
        ".oci/session-token": "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJleHAiOjIwODQxMDAwMDAsImlhdCI6MjA4NDA5MDAwMH0.old"
      },
      "fileModes": {
        ".oci/session-token": 420
      }
    },
    "replies": {
      "body": {
        "token": "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJleHAiOjIwODQxMDM2MDAsImlhdCI6MjA4NDA5MzYwMH0.new"
      }
    },
    "expect": {
      "files": {
        ".oci/session-token": "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJleHAiOjIwODQxMDM2MDAsImlhdCI6MjA4NDA5MzYwMH0.new"
      },
      "fileModes": {
        ".oci/session-token": 384
      }
    }
  },
  {
    "id": "session-refresh-minimal-profile",
    "key": "session refresh",
    "argv": [
      "session",
      "refresh",
      "--config-file",
      "{home}/.oci/session_config",
      "--profile",
      "SESSION"
    ],
    "httpsProxy": true,
    "sandbox": {
      "noConfig": true,
      "files": {
        ".oci/session_config": "[SESSION]\nregion=us-phoenix-1\nkey_file=~/.oci/key.pem\nsecurity_token_file=~/.oci/session-token\n",
        ".oci/key.pem": "{fakeKey}",
        ".oci/session-token": "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJleHAiOjIwODQxMDAwMDAsImlhdCI6MjA4NDA5MDAwMH0.old"
      }
    },
    "replies": {
      "body": {
        "token": "refreshed-minimal-token"
      }
    },
    "expect": {
      "files": {
        ".oci/session-token": "refreshed-minimal-token"
      },
      "fileModes": {
        ".oci/session-token": 384
      }
    }
  },
