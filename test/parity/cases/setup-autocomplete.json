[
  {
    "id": "setup-autocomplete-no-rc-create-bashrc-confirm",
    "key": "setup autocomplete",
    "argv": ["setup", "autocomplete"],
    "stdin": "y\ny\n",
    "sandbox": {
      "noConfig": true
    },
    "expect": {
      "files": {
        "lib/oci_autocomplete.sh": "# coding: utf-8\n# Copyright (c) 2016, 2026, Oracle and/or its affiliates. All rights reserved.\n# This software is dual-licensed to you under the Universal Permissive License (UPL) 1.0 as shown at https://oss.oracle.com/licenses/upl or Apache License 2.0 as shown at http://www.apache.org/licenses/LICENSE-2.0. You may choose either license.\n\n_oci_completion() {\n    COMPREPLY=( $( env COMP_WORDS=\"${COMP_WORDS[*]}\" \\\n                   COMP_CWORD=$COMP_CWORD \\\n                   _OCI_COMPLETE=complete $1 ) )\n    return 0\n}\n\ncomplete -F _oci_completion -o default oci;"
      },
      "fileModes": {
        "lib/oci_autocomplete.sh": 420
      }
    }
  },
  {
    "id": "setup-autocomplete-no-rc-default-blank-accept",
    "key": "setup autocomplete",
    "argv": ["setup", "autocomplete"],
    "stdin": "\n\n",
    "sandbox": {
      "noConfig": true
    },
    "expect": {
      "fileModes": {
        "lib/oci_autocomplete.sh": 420
      }
    }
  },
