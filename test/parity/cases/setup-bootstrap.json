  {
    "id": "setup-bootstrap-upload",
    "key": "setup bootstrap",
    "argv": [
      "setup",
      "bootstrap",
      "--region",
      "us-phoenix-1",
      "--profile-name",
      "BOOT",
      "--config-location",
      "{home}/.oci/bootstrap"
    ],
    "stdin": "N/A\nN/A\n",
    "httpsProxy": true,
    "env": {
      "BROWSER": "{home}/browser"
    },
    "sandbox": {
      "files": {
        "browser": "#!/bin/sh\ncurl --fail --silent --max-time 3 \"http://127.0.0.1:8181/token?security_token=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJvY2lkMS51c2VyLm9jMS4udGVzdHVzZXIiLCJ0ZW5hbnQiOiJvY2lkMS50ZW5hbmN5Lm9jMS4udGVzdHRlbmFuY3kiLCJleHAiOjQxMDI0NDQ4MDB9.sig\" </dev/null >/dev/null 2>&1 &\n"
      },
      "fileModes": {
        "browser": 448
      }
    },
    "replies": [
      {
        "status": 200,
        "body": [
          {
            "regionName": "us-phoenix-1",
            "isHomeRegion": false
          },
          {
            "regionName": "us-ashburn-1",
            "isHomeRegion": true
          }
        ]
      },
      {
        "status": 200
      }
    ],
    "expect": {
      "requests": 2,
      "files": {
        ".oci/sessions/BOOT/token": null
      },
      "fileModes": {
        ".oci/bootstrap": 384,
        ".oci/sessions/BOOT": 448,
        ".oci/sessions/BOOT/oci_api_key.pem": 384,
        ".oci/sessions/BOOT/oci_api_key_public.pem": 384
      }
    }
  },
