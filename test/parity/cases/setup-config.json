[
  {
    "id": "setup-config-new-key-no-passphrase",
    "key": "setup config",
    "argv": ["setup", "config"],
    "stdin": "\nocid1.user.oc1..aaaaaaaabocifakeuser000000000000000000000000000000000000000\nocid1.tenancy.oc1..aaaaaaaabocifaketenancy0000000000000000000000000000000000\n1\n\n\n\nN/A\nN/A\n",
    "sandbox": {
      "noConfig": true
    },
    "expect": {
      "fileModes": {
        ".oci": 448,
        ".oci/config": 384,
        ".oci/oci_api_key.pem": 384,
        ".oci/oci_api_key_public.pem": 384
      }
    }
  },
  {
    "id": "setup-config-new-key-passphrase-written",
    "key": "setup config",
    "argv": ["setup", "config"],
    "stdin": "~/custom-cfg/config\nocid1.user.oc1..aaaaaaaabocifakeuser000000000000000000000000000000000000000\nocid1.tenancy.oc1..aaaaaaaabocifaketenancy0000000000000000000000000000000000\nus-ashburn-1\ny\n~/custom-keys\nmy_key\nmysecret\nmysecret\ny\n",
    "sandbox": {
      "noConfig": true
    },
    "expect": {
      "fileModes": {
        "custom-cfg": 448,
        "custom-cfg/config": 384,
        "custom-keys": 448,
        "custom-keys/my_key.pem": 384,
        "custom-keys/my_key_public.pem": 384
      }
    }
  },
