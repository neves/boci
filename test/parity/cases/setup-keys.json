[
  {
    "id": "setup-keys-passphrase-basic",
    "key": "setup keys",
    "argv": [
      "setup",
      "keys",
      "--output-dir",
      "{home}/keys",
      "--passphrase",
      "mysecret"
    ],
    "sandbox": {
      "noConfig": true
    },
    "expect": {
      "fileModes": {
        "keys": 448,
        "keys/oci_api_key.pem": 384,
        "keys/oci_api_key_public.pem": 384
      }
    }
  },
  {
    "id": "setup-keys-default-dir-and-name",
    "key": "setup keys",
    "argv": ["setup", "keys", "--passphrase", "mysecret"],
    "sandbox": {
      "noConfig": true
    },
    "expect": {
      "fileModes": {
        ".oci": 448,
        ".oci/oci_api_key.pem": 384,
        ".oci/oci_api_key_public.pem": 384
      }
    }
  },
